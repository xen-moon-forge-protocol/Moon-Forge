# ─────────────────────────────────────────────────────────────────────────────
#  Moon Forge — EVM portal deployment (Hardhat) environment template
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to git — it is listed in .gitignore.
#  This file (.env.example) is committed and contains no secrets.
#
#  Scope: these variables are read only by hardhat.config.ts and
#  scripts/deploy_portal.ts to deploy MoonForgePortal.sol on EVM chains.
#  The X1 (SVM) program is deployed with Anchor, and the oracle/keeper use
#  their own variables (see oracle/README.md and OPERATORS.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── EVM DEPLOYER ──────────────────────────────────────────────────────────────
# Private key of the wallet that pays gas to deploy MoonForgePortal.
# MoonForgePortal has no owner, admin, fee, pause or upgrade function, so this
# key has no protocol power after (or during) deployment — it only pays gas.
# Use a dedicated, freshly generated wallet funded with just enough gas.
PRIVATE_KEY=0x_your_deployer_private_key_here

# Optional: override the XEN token address for the target chain
# (scripts/deploy_portal.ts otherwise uses its built-in per-chain map).
# XEN_ADDRESS=0x...

# ── EVM RPC ENDPOINTS (optional — public defaults are used when unset) ────────
ETH_RPC=https://eth.llamarpc.com
OP_RPC=https://mainnet.optimism.io
BSC_RPC=https://bsc-dataseed.binance.org
POLYGON_RPC=https://polygon.llamarpc.com
AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
BASE_RPC=https://mainnet.base.org
PULSE_RPC=https://rpc.pulsechain.com

# ── TESTNET ───────────────────────────────────────────────────────────────────
SEPOLIA_RPC=https://rpc.sepolia.org

# ── BLOCK EXPLORER API KEYS (optional — only for source verification) ─────────
ETHERSCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
BASESCAN_API_KEY=
