{
    "name": "moonforge-frontend",
    "version": "2.0.0",
    "description": "Moon Forge Protocol: burn XEN on a supported EVM chain, receive XNT on X1. Zero protocol fee on the burn path.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node scripts/check-program-id.mjs && node scripts/check-repo-links.mjs && node scripts/prerender.mjs --check && tsc && vite build && node scripts/prerender.mjs",
        "check:program-id": "node scripts/check-program-id.mjs",
        "check:repo-links": "node scripts/check-repo-links.mjs",
        "measure:cu": "node scripts/measure-cu.mjs",
        "prerender": "node scripts/prerender.mjs",
        "prerender:check": "node scripts/prerender.mjs --check",
        "prerender:public": "node scripts/prerender.mjs --write-public",
        "preview": "vite preview",
        "deploy": "npm run build && gh-pages -d dist"
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.32.1",
        "@noble/hashes": "^1.4.0",
        "@solana/web3.js": "^1.98.4",
        "buffer": "^6.0.3",
        "ethers": "^6.9.0",
        "framer-motion": "^10.16.16",
        "lucide-react": "^0.303.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.1"
    },
    "devDependencies": {
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "gh-pages": "^6.1.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10"
    }
}
