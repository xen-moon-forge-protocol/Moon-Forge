# Moon Forge oracle v2 — copy to .env. NEVER commit .env.

# ── X1 ──────────────────────────────────────────────────────────────────────
X1_RPC_URL=https://rpc.mainnet.x1.xyz
X1_PROGRAM_ID=57UE1U1t23ztg2noLp8pcpGW1B1Xw25rLH6ra9Mchea9
# Solana/SVM keypair of the oracle (JSON array [..64 numbers..] or Base58). NOT an EVM key.
ORACLE_PRIVATE_KEY=
# Where epoch files are written (served by GitHub Pages)
EPOCHS_DIR=../frontend/public/epochs

# ── Payout policy (can only LOWER payouts; recorded in every epoch file) ──────
RATE_CAP_K=1.25
MAX_PRICE_MOVE=0.5
# Optional manual XNT price in USD if the price APIs are down
XNT_USD_OVERRIDE=

# ── Portals ──
# Leave these UNSET: the five deployed portals and their deploy blocks are read from deployments/portals.json
# (Optimism, BSC, Polygon, Avalanche, Base). Set PORTAL_<X>= (empty) only to skip a chain, or a portal address
# plus START_<X> (its deploy block) for a local or forked deployment. Ethereum, PulseChain and Moonbeam have no
# portal and no oracle entry: their variables are ignored.
# PORTAL_OP=
# START_OP=
# PORTAL_BSC=
# START_BSC=
# PORTAL_POLYGON=
# START_POLYGON=
# PORTAL_AVAX=
# START_AVAX=
# PORTAL_BASE=
# START_BASE=

# ── EVM RPCs (defaults are public endpoints; use your own for reliability) ────
ETH_RPC_URL=
OP_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
BASE_RPC_URL=
PULSE_RPC_URL=
MOONBEAM_RPC_URL=
