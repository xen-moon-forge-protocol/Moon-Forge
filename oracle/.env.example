# Moon Forge oracle v2 — copy to .env. NEVER commit .env.

# ── X1 ──────────────────────────────────────────────────────────────────────
X1_RPC_URL=https://rpc.mainnet.x1.xyz
X1_PROGRAM_ID=57UE1U1t23ztg2noLp8pcpGW1B1Xw25rLH6ra9Mchea9
# Solana/SVM keypair of the oracle (JSON array [..64 numbers..] or Base58). NOT an EVM key.
ORACLE_PRIVATE_KEY=
# Where epoch files are written (served by GitHub Pages)
EPOCHS_DIR=../frontend/public/epochs

# ── Payout policy (can only LOWER payouts; recorded in every epoch file) ──────
RATE_CAP_K=1.25
MAX_PRICE_MOVE=0.5
# Optional manual XNT price in USD if the price APIs are down
XNT_USD_OVERRIDE=

# ── Portals (fill after deploying MoonForgePortal v2; empty = chain skipped) ──
# START_* = block number of the portal deployment
PORTAL_ETH=
START_ETH=0
PORTAL_OP=
START_OP=0
PORTAL_BSC=
START_BSC=0
PORTAL_POLYGON=
START_POLYGON=0
PORTAL_AVAX=
START_AVAX=0
PORTAL_BASE=
START_BASE=0
PORTAL_PULSE=
START_PULSE=0
PORTAL_MOONBEAM=
START_MOONBEAM=0

# ── EVM RPCs (defaults are public endpoints; use your own for reliability) ────
ETH_RPC_URL=
OP_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
BASE_RPC_URL=
PULSE_RPC_URL=
MOONBEAM_RPC_URL=
